# Plantilla de configuracion. Copia este fichero a ".env" y rellena con los
# valores reales. El fichero ".env" NO debe versionarse (ver .gitignore).
#
# IMPORTANTE: NO uses comillas en los valores. Docker (--env-file) no las
# interpreta y las incluiria literalmente en el valor (rompe, p.ej., el puerto).

# Credenciales para la base de datos SQL Server
DB_SERVER=IP,PUERTO
DB_DATABASE=nombre_bd
DB_USERNAME=usuario
DB_PASSWORD=contrasena
DB_DRIVER={ODBC Driver 17 for SQL Server}

# Credenciales para la API externa del proveedor (Dachser)
PROVIDER_API_BASE_URL=https://api-gateway.dachser.com/rest/v2/
PROVIDER_API_KEY=tu-api-key
DACHSER_API_BASE_URL=https://api-gateway.dachser.com
DACHSER_API_KEY=tu-api-key
DACHSER_CONSIGNOR_ID=00000000
DACHSER_FORWARDER_ID=00000000

# Credenciales para la base de datos MySQL (log de envios)
MYSQL_HOST=ip_mysql
MYSQL_USER=usuario
MYSQL_PASSWORD=contrasena
MYSQL_DATABASE=nombre_bd

# Configuracion de la aplicacion Flask
# FLASK_DEBUG debe ser false en produccion. Solo true en entornos de desarrollo.
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5002
