# Plantilla de configuracion. Copia este fichero a ".env" y rellena los valores reales.
# El fichero ".env" NO debe versionarse (ver .gitignore).
# IMPORTANTE: NO uses comillas en los valores. Docker (env-file) no las interpreta
# y las incluiria literalmente en el valor.

# Conexion a SQL Server (Sage X3)
DB_SERVER=192.168.28.100
DB_DATABASE=x3
DB_USERNAME=it
DB_PASSWORD=@Famesa123
DB_DRIVER={ODBC Driver 17 for SQL Server}
# Segundos de espera al conectar con SQL Server (subir si la red es lenta)
DB_TIMEOUT=5

# Datos propios del cargador contractual (constantes de la empresa)
# Si el nombre se deja vacio se usa el nombre del sitio de carga del albaran
# (LIVE.FACILITY). El NIF y el domicilio conviene rellenarlos para que el DeCA
# quede completo.
DECA_CARGADOR_NOMBRE=
DECA_CARGADOR_NIF=
DECA_CARGADOR_DOMICILIO=


# Endpoint corporativo de subida del DeCA (HTTPS obligatorio, TLS >= 1.2)
DECA_UPLOAD_URL=https://denox.eu/DECA/upload_deca.php
# URL publica base donde quedan publicados los PDF.
# DEBE coincidir con la variable $baseUrl de upload_deca.php
DECA_BASE_URL=https://denox.eu/DECA/deca_storage/

# SMTP para el envio del DeCA al conductor por email (opcional; si se deja vacio,
# el boton de envio devolvera un error controlado)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=deca@denox.eu

# Aplicacion
APP_PORT=5010
# Directorio local (dentro del contenedor) donde se guarda copia de los PDF generados
PDF_DIR=deca_pdf